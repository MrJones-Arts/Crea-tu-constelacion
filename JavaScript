connectionsSvg.addEventListener('keydown', event => {
	const handle = event.target.closest?.('.connection-handle');
	const movement = {
		ArrowUp: { x: 0, y: -5 },
		ArrowDown: { x: 0, y: 5 },
		ArrowLeft: { x: -5, y: 0 },
		ArrowRight: { x: 5, y: 0 }
	}[event.key];
	if (!handle || !movement) return;
	event.preventDefault();
	const connection = connections.find(item => item.id === handle.dataset.connectionId);
	const segmentIndex = Number(handle.dataset.segmentIndex);
	const start = stars.find(star => star.id === connection?.starIds[segmentIndex]);
	const end = stars.find(star => star.id === connection?.starIds[segmentIndex + 1]);
	if (!connection || !start || !end) return;
	const current = getConnectionBend(connection, segmentIndex, start, end);
	const step = event.shiftKey ? 20 : 5;
	setConnectionBend(connection, segmentIndex, {
		x: current.x + movement.x * step / 5,
		y: current.y + movement.y * step / 5
	});
	drawConnections();
	[...connectionsSvg.querySelectorAll('.connection-handle')]
		.find(item => item.dataset.connectionId === connection.id && Number(item.dataset.segmentIndex) === segmentIndex)
		?.focus();
	persist();
});

function constrainPan() {
	const width = map.clientWidth;
	const height = map.clientHeight;
	const minPanX = width * (1 - WORLD_SCALE * zoom);
	const maxPanX = 0;
	const minPanY = height * (1 - WORLD_SCALE * zoom);
	const maxPanY = 0;
	panX = clamp(panX, minPanX, maxPanX);
	panY = clamp(panY, minPanY, maxPanY);
}

function updateMapView() {
	constrainPan();
	mapWorld.style.transform = `translate(${panX}px, ${panY}px) scale(${zoom})`;
	document.getElementById('zoom-level').value = `${Math.round(zoom * 100)}%`;
	document.getElementById('zoom-out').disabled = zoom <= MIN_ZOOM;
	document.getElementById('zoom-in').disabled = zoom >= MAX_ZOOM;
	drawConnections();
}

function handleMapResize() {
	const width = map.clientWidth;
	const height = map.clientHeight;
	if (!width || !height) return;
	if (width === previousMapWidth && height === previousMapHeight) return;
	if (previousMapWidth > 0) panX *= width / previousMapWidth;
	if (previousMapHeight > 0) panY *= height / previousMapHeight;
	previousMapWidth = width;
	previousMapHeight = height;
	updateMapView();
}

function setZoom(nextZoom, anchorX = map.clientWidth / 2, anchorY = map.clientHeight / 2) {
	const updatedZoom = clamp(nextZoom, MIN_ZOOM, MAX_ZOOM);
	const ratio = updatedZoom / zoom;
	panX = anchorX - (anchorX - panX) * ratio;
	panY = anchorY - (anchorY - panY) * ratio;
	zoom = updatedZoom;
	updateMapView();
}

function enableDragging(node, star) {
	let startX = 0;
	let startY = 0;
	let initialX = 0;
	let initialY = 0;
	let moved = false;

	node.addEventListener('pointerdown', event => {
		if (isPresentationMode || event.button !== 0) return;
		event.preventDefault();
		startX = event.clientX;
		startY = event.clientY;
		initialX = star.x;
		initialY = star.y;
		moved = false;
		node.setPointerCapture(event.pointerId);
	});
	node.addEventListener('pointermove', event => {
		if (isPresentationMode || !node.hasPointerCapture(event.pointerId)) return;
		const rect = map.getBoundingClientRect();
		const dx = event.clientX - startX;
		const dy = event.clientY - startY;
		if (!moved && Math.hypot(dx, dy) > 5) {
			moved = true;
			node.classList.add('dragging');
		}
		if (!moved) return;
		star.x = clamp(initialX + dx / (rect.width * zoom) * 100, -494, 494);
		star.y = clamp(initialY + dy / (rect.height * zoom) * 100, -494, 494);
		node.style.left = `${(star.x + WORLD_SCALE * 50) / WORLD_SCALE}%`;
		node.style.top = `${(star.y + WORLD_SCALE * 50) / WORLD_SCALE}%`;
		drawConnections();
	});
	node.addEventListener('pointerup', event => {
		if (isPresentationMode) return;
		if (node.hasPointerCapture(event.pointerId)) node.releasePointerCapture(event.pointerId);
		node.classList.remove('dragging');
		if (moved) {
			persist();
			drawConnections();
		} else if (connectMode) {
			if (selectedIds.has(star.id)) selectedIds.delete(star.id);
			else selectedIds.add(star.id);
			render();
		} else {
			openStarDialog(star);
		}
	});
	node.addEventListener('keydown', event => {
		if (isPresentationMode) return;
		if (event.key === 'Enter' || event.key === ' ') {
			event.preventDefault();
			if (connectMode) {
				selectedIds.has(star.id) ? selectedIds.delete(star.id) : selectedIds.add(star.id);
				render();
			} else openStarDialog(star);
		}
	});
}

