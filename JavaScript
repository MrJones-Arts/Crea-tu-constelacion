function persist() {
	try {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(createMapSnapshot()));
		document.getElementById('save-status').textContent = 'Guardado en este dispositivo';
	} catch {
		document.getElementById('save-status').textContent = 'No se pudo guardar';
		showToast('La imagen es demasiado grande para guardar en este navegador.');
	}
}

