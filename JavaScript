		savedAt: new Date().toISOString(),
		stars,
		connections
	};
}

function saveMapFile() {
	const content = createTextMapSnapshot(createMapSnapshot());
	const file = new Blob([content], { type: 'text/plain;charset=utf-8' });
	const url = URL.createObjectURL(file);
	const link = document.createElement('a');
	const date = new Date().toISOString().slice(0, 10);
	link.href = url;
	link.download = `constelacion-mapa-${date}.txt`;
	link.click();
	setTimeout(() => URL.revokeObjectURL(url), 1000);
	showToast('Copia del mapa descargada como archivo de texto.');
}

function escapeTextField(value) {
	return String(value)
		.replace(/\\/g, '\\\\')
		.replace(/\t/g, '\\t')
		.replace(/\r/g, '\\r')
		.replace(/\n/g, '\\n');
}

function unescapeTextField(value) {
	return value.replace(/\\([\\tnr])/g, (_, character) => ({
		'\\': '\\',
		t: '\t',
		n: '\n',
		r: '\r'
	})[character]);
}

function createTextMapSnapshot(data) {
	const lines = [
		'# Copia de seguridad de Constelacion',
		'# Para restaurarla, usa "Abrir archivo" en la aplicacion.',
		'CONSTELACION-TXT\t1',
		`COORDINATE_SPACE\t${data.coordinateSpace}`,
		`SAVED_AT\t${escapeTextField(data.savedAt)}`
	];
	for (const star of data.stars) {
		lines.push([
			'STAR',
			escapeTextField(star.id),
			escapeTextField(star.title),
			escapeTextField(star.description || ''),
			escapeTextField(star.image || ''),
			star.x,
			star.y
		].join('\t'));
	}
	for (const connection of data.connections) {
		const bends = Array.from({ length: connection.starIds.length - 1 }, (_, index) => {
			const bend = connection.bends?.[index];
			return bend ? [bend.x, bend.y] : ['', ''];
		}).flat();
		lines.push([
			'CONNECTION',
			escapeTextField(connection.id),
			connection.style,
			connection.color || '#a9e4cd',
			connection.starIds.length,
			...connection.starIds.map(escapeTextField),
			...bends
		].join('\t'));
	}
	return `${lines.join('\n')}\n`;
}

function parseTextMapSnapshot(content) {
	const lines = content.split(/\r?\n/).filter(line => line && !line.startsWith('#'));
	if (lines.shift() !== 'CONSTELACION-TXT\t1') {
		throw new Error('El archivo no tiene un formato de mapa válido.');
	}
	const coordinateFields = lines.shift()?.split('\t');
	const savedAtFields = lines.shift()?.split('\t');
	if (coordinateFields?.length !== 2 || coordinateFields[0] !== 'COORDINATE_SPACE' ||
		savedAtFields?.length !== 2 || savedAtFields[0] !== 'SAVED_AT') {
		throw new Error('El archivo de texto está incompleto o dañado.');
	}

	const stars = [];
	const connections = [];
	for (const line of lines) {
		const fields = line.split('\t');
		if (fields[0] === 'STAR' && fields.length === 7) {
			const x = Number(fields[5]);
			const y = Number(fields[6]);
			if (!Number.isFinite(x) || !Number.isFinite(y)) {
				throw new Error('El archivo contiene una estrella incompleta.');
			}
			stars.push({
				id: unescapeTextField(fields[1]),
				title: unescapeTextField(fields[2]),
				description: unescapeTextField(fields[3]),
				image: unescapeTextField(fields[4]),
				x,
				y
			});
			continue;
		}
		if (fields[0] === 'CONNECTION') {
			const starCount = Number(fields[4]);
			const expectedLength = 5 + starCount + (starCount - 1) * 2;
			if (!Number.isInteger(starCount) || starCount < 2 || fields.length !== expectedLength) {
				throw new Error('El archivo contiene una conexión incompleta.');
			}
			const bends = Array.from({ length: starCount - 1 }, (_, index) => {
				const xField = fields[5 + starCount + index * 2];
				const yField = fields[6 + starCount + index * 2];
				if (xField === '' && yField === '') return null;
				if (xField === '' || yField === '') {
					throw new Error('El archivo contiene una conexión incompleta.');
				}
				const x = Number(xField);
				const y = Number(yField);
				if (!Number.isFinite(x) || !Number.isFinite(y)) {
					throw new Error('El archivo contiene una conexión incompleta.');
				}
				return { x, y };
			});
			connections.push({
				id: unescapeTextField(fields[1]),
				style: fields[2],
				color: fields[3],
				starIds: fields.slice(5, 5 + starCount).map(unescapeTextField),
				bends
			});
			continue;
		}
		throw new Error('El archivo de texto contiene datos que no se reconocen.');
	}
	return {
		format: 'constelacion-map',
		version: 1,
		coordinateSpace: Number(coordinateFields[1]),
		savedAt: unescapeTextField(savedAtFields[1]),
		stars,
		connections
	};
}

function parseMapSnapshot(data) {
	if (!data || data.format !== 'constelacion-map' || data.version !== 1 || !Array.isArray(data.stars) || !Array.isArray(data.connections)) {
		throw new Error('El archivo no tiene un formato de mapa válido.');
	}
	if (data.coordinateSpace !== WORLD_SCALE) {
		throw new Error('Este archivo usa una versión de coordenadas incompatible.');
	}
	const importedStars = data.stars.map(star => {
		if (!star || typeof star.title !== 'string' || !star.title.trim() || !Number.isFinite(star.x) || !Number.isFinite(star.y)) {
			throw new Error('El archivo contiene una estrella incompleta.');
		}
		return {
			id: typeof star.id === 'string' ? star.id : crypto.randomUUID(),
			title: star.title,
			description: typeof star.description === 'string' ? star.description : '',
			image: typeof star.image === 'string' ? star.image : '',
			x: clamp(star.x, -494, 494),
			y: clamp(star.y, -494, 494)
		};
	});
	const starIds = new Set(importedStars.map(star => star.id));
	const importedConnections = data.connections
		.filter(connection => connection && Array.isArray(connection.starIds) && connection.starIds.length >= 2 && connection.starIds.every(id => starIds.has(id)))
		.map(connection => ({
			id: typeof connection.id === 'string' ? connection.id : crypto.randomUUID(),
			starIds: [...connection.starIds],
			style: connection.style === 'dotted' ? 'dotted' : 'solid',
			color: CONNECTION_COLORS.has(connection.color) ? connection.color : '#a9e4cd',
			bends: Array.from({ length: connection.starIds.length - 1 }, (_, index) => {
				const bend = Array.isArray(connection.bends) ? connection.bends[index] : null;
				return bend && Number.isFinite(bend.x) && Number.isFinite(bend.y)
					? { x: clamp(bend.x, -494, 494), y: clamp(bend.y, -494, 494) }
					: null;
			})
		}));
	return { stars: importedStars, connections: importedConnections };
}

async function loadMapFile(file) {
	try {
		const content = await file.text();
		const data = content.trimStart().startsWith('{')
			? JSON.parse(content)
			: parseTextMapSnapshot(content);
		const parsed = parseMapSnapshot(data);
		if ((stars.length || connections.length) && !confirm('Abrir este archivo reemplazará el mapa actual. ¿Continuar?')) return;
		stars = parsed.stars;
		connections = parsed.connections;
		selectedIds.clear();
			selectedConnectionIds.clear();
			persist();
		render();
		showToast('Mapa cargado correctamente.');
	} catch (error) {
		showToast(error instanceof SyntaxError ? 'El archivo no tiene un formato válido.' : error.message || 'No se pudo abrir el archivo.');
	} finally {
		document.getElementById('open-file').value = '';
	}
}

function showToast(message) {
	toast.textContent = message;
	toast.classList.add('visible');
	clearTimeout(toastTimer);
	toastTimer = setTimeout(() => toast.classList.remove('visible'), 2600);
}

function showLoadingScreen(duration = 1200) {
	clearTimeout(loadingTimer);
	loadingScreen.classList.remove('is-hidden');
	loadingTimer = setTimeout(() => loadingScreen.classList.add('is-hidden'), duration);
}

function render() {
	nodesLayer.replaceChildren();
	stars.forEach((star, index) => {
		const node = document.createElement('div');
		node.className = `star-node${selectedIds.has(star.id) ? ' selected' : ''}`;
		node.style.left = `${(star.x + WORLD_SCALE * 50) / WORLD_SCALE}%`;
		node.style.top = `${(star.y + WORLD_SCALE * 50) / WORLD_SCALE}%`;
		node.tabIndex = isPresentationMode ? -1 : 0;
		node.setAttribute('role', isPresentationMode ? 'img' : 'button');
		node.setAttribute('aria-label', `${star.title}${isPresentationMode ? '' : connectMode ? ', seleccionar para conectar' : ', editar'}`);
		node.dataset.id = star.id;
		node.style.animationDelay = `${Math.min(index * 65, 360)}ms`;

		const aura = document.createElement('span');
		aura.className = 'node-aura';
		if (star.image) {
			const image = document.createElement('img');
			image.className = 'node-image';
			image.src = star.image;
			image.alt = '';
			aura.append(image);
		}
		const core = document.createElement('span');
		core.className = 'node-core';
		aura.append(core);
		const label = document.createElement('span');
		label.className = 'node-title';
		label.textContent = star.title;
		const banner = document.createElement('span');
		banner.className = 'star-banner';
		banner.setAttribute('aria-hidden', 'true');
		if (star.image) {
			const bannerImage = document.createElement('img');
			bannerImage.className = 'banner-image';
			bannerImage.src = star.image;
			bannerImage.alt = '';
			banner.append(bannerImage);
		} else {
			const imagePlaceholder = document.createElement('span');
			imagePlaceholder.className = 'banner-image-placeholder';
			imagePlaceholder.textContent = '✦';
			banner.append(imagePlaceholder);
		}
		const bannerContent = document.createElement('span');
		bannerContent.className = 'banner-content';
		const bannerTitle = document.createElement('strong');
		bannerTitle.textContent = star.title;
		const bannerDescription = document.createElement('span');
		bannerDescription.textContent = star.description || 'Sin descripción';
		bannerContent.append(bannerTitle, bannerDescription);
		banner.append(bannerContent);
		node.append(aura, label, banner);
		if (isPresentationMode) {
			const setBannerVisibility = visible => {
				node.classList.toggle('show-banner', visible);
				banner.style.display = visible ? 'grid' : 'none';
			};
			node.addEventListener('pointerenter', () => setBannerVisibility(true));
			node.addEventListener('pointerleave', () => setBannerVisibility(false));
			node.addEventListener('focus', () => setBannerVisibility(true));
			node.addEventListener('blur', () => setBannerVisibility(false));
		}
		nodesLayer.append(node);
		enableDragging(node, star);
	});

	drawConnections();
	renderList();
	const hasStars = stars.length > 0;
	document.getElementById('map-hint').classList.toggle('hidden', hasStars);
	document.getElementById('star-count').textContent = String(stars.length);
	document.getElementById('map-count').textContent = `${String(stars.length).padStart(2, '0')} OBJETOS`;
	document.getElementById('connection-summary').textContent = `${connections.length} ${connections.length === 1 ? 'conexión' : 'conexiones'} en tu universo`;
	updateConnectControls();
}

function renderList() {
	const list = document.getElementById('star-list');
	list.replaceChildren();
	document.getElementById('empty-list').hidden = stars.length > 0;
	stars.forEach(star => {
		const row = document.createElement('div');
		row.className = 'list-star-row';
		const button = document.createElement('button');
		button.className = 'list-star';
		button.type = 'button';
		button.title = 'Editar estrella';
		if (star.image) {
			const image = document.createElement('img');
			image.src = star.image;
			image.alt = '';
			button.append(image);
		} else {
			const orb = document.createElement('span');
			orb.className = 'list-orb';
			orb.textContent = '✦';
			button.append(orb);
		}
		const label = document.createElement('span');
		label.textContent = star.title;
		button.append(label);
		button.addEventListener('click', () => openStarDialog(star));
		const removeButton = document.createElement('button');
		removeButton.className = 'list-delete';
		removeButton.type = 'button';
		removeButton.textContent = '×';
		removeButton.title = `Eliminar estrella ${star.title}`;
		removeButton.setAttribute('aria-label', `Eliminar estrella ${star.title}`);
		removeButton.addEventListener('click', () => deleteStar(star));
		row.append(button, removeButton);
		list.append(row);
	});

	const connectionList = document.getElementById('connection-list');
	connectionList.replaceChildren();
	document.getElementById('empty-connections').hidden = connections.length > 0;
	document.getElementById('connection-count').textContent = String(connections.length);
	connections.forEach(connection => {
		const row = document.createElement('div');
		row.className = 'connection-row';
		const label = document.createElement('span');
		label.textContent = connection.starIds
			.map(id => stars.find(star => star.id === id)?.title)
			.filter(Boolean)
			.join(' · ');
		const selectButton = document.createElement('button');
		selectButton.className = 'connection-select';
		selectButton.type = 'button';
		selectButton.textContent = label.textContent;
		selectButton.title = 'Seleccionar para cambiar el color';
		selectButton.setAttribute('aria-label', `Seleccionar conexión ${label.textContent} para cambiar su color`);
		selectButton.setAttribute('aria-pressed', String(selectedConnectionIds.has(connection.id)));
		selectButton.style.setProperty('--connection-color', CONNECTION_COLORS.has(connection.color) ? connection.color : '#a9e4cd');
		selectButton.addEventListener('click', () => {
			if (!connectMode) {
				connectMode = true;
				connectionModeButton.setAttribute('aria-pressed', 'true');
				connectionOptions.hidden = false;
			}
			if (selectedConnectionIds.has(connection.id)) selectedConnectionIds.delete(connection.id);
			else selectedConnectionIds.add(connection.id);
			render();
		});
		const removeButton = document.createElement('button');
		removeButton.className = 'list-delete';
		removeButton.type = 'button';
		removeButton.textContent = '×';
		removeButton.title = 'Eliminar conexión';
		removeButton.setAttribute('aria-label', `Eliminar conexión ${label.textContent}`);
		removeButton.addEventListener('click', () => deleteConnection(connection));
		row.append(selectButton, removeButton);
		connectionList.append(row);
	});
}

function deleteStar(star) {
	if (!confirm(`¿Eliminar la estrella «${star.title}» y sus conexiones?`)) return;
	stars = stars.filter(item => item.id !== star.id);
	connections = connections
		.map(connection => {
			const starIds = connection.starIds.filter(id => id !== star.id);
			const bends = starIds.slice(0, -1).map((id, index) => {
				const originalIndex = connection.starIds.indexOf(id);
				const nextIndex = connection.starIds.indexOf(starIds[index + 1]);
				return nextIndex === originalIndex + 1 ? connection.bends?.[originalIndex] ?? null : null;
			});
			return { ...connection, starIds, bends };
		})
		.filter(connection => connection.starIds.length >= 2);
	selectedConnectionIds.clear();
	selectedIds.delete(star.id);
	persist();
	render();
	showLoadingScreen();
	showToast('Estrella y conexiones asociadas eliminadas.');
}

function deleteConnection(connection) {
	const names = connection.starIds
		.map(id => stars.find(star => star.id === id)?.title)
		.filter(Boolean)
		.join(' · ');
	if (!confirm(`¿Eliminar la conexión ${names}?`)) return;
	connections = connections.filter(item => item.id !== connection.id);
	selectedConnectionIds.delete(connection.id);
	persist();
	render();
	showToast('Conexión eliminada.');
}

function getConnectionBend(connection, segmentIndex, start, end) {
	const bend = connection.bends?.[segmentIndex];
	return bend && Number.isFinite(bend.x) && Number.isFinite(bend.y)
		? bend
		: { x: (start.x + end.x) / 2, y: (start.y + end.y) / 2 };
}

function setConnectionBend(connection, segmentIndex, bend) {
	if (!Array.isArray(connection.bends)) connection.bends = [];
	while (connection.bends.length <= segmentIndex) connection.bends.push(null);
	connection.bends[segmentIndex] = {
		x: clamp(bend.x, -494, 494),
		y: clamp(bend.y, -494, 494)
	};
}

function drawConnections() {
	const width = map.clientWidth;
	const height = map.clientHeight;
	connectionsSvg.setAttribute('viewBox', `0 0 ${width * WORLD_SCALE} ${height * WORLD_SCALE}`);
	connectionsSvg.replaceChildren();
	const handles = [];
	connections.forEach(connection => {
		const linkedStars = connection.starIds.map(id => stars.find(star => star.id === id)).filter(Boolean);
		if (linkedStars.length < 2) return;
		const toSvgPoint = point => ({
			x: width * (point.x + WORLD_SCALE * 50) / 100,
			y: height * (point.y + WORLD_SCALE * 50) / 100
		});
		const points = [toSvgPoint(linkedStars[0])];
		for (let index = 0; index < linkedStars.length - 1; index++) {
			const start = linkedStars[index];
			const end = linkedStars[index + 1];
			const bend = getConnectionBend(connection, index, start, end);
			points.push(toSvgPoint(bend), toSvgPoint(end));
			handles.push({ connection, segmentIndex: index, bend, start, end });
		}
		const path = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
		path.setAttribute('points', points.map(point => `${point.x},${point.y}`).join(' '));
		path.setAttribute('class', `connection-path${connection.style === 'dotted' ? ' dotted' : ''}`);
		path.style.setProperty('--connection-color', CONNECTION_COLORS.has(connection.color) ? connection.color : '#a9e4cd');
		connectionsSvg.append(path);
	});
	handles.forEach(({ connection, segmentIndex, bend, start, end }) => {
		const handle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
		const point = { x: map.clientWidth * (bend.x + WORLD_SCALE * 50) / 100, y: map.clientHeight * (bend.y + WORLD_SCALE * 50) / 100 };
		handle.setAttribute('cx', point.x);
		handle.setAttribute('cy', point.y);
		handle.setAttribute('r', '12');
		handle.setAttribute('class', 'connection-handle');
		handle.setAttribute('tabindex', '0');
		handle.setAttribute('role', 'button');
		handle.setAttribute('aria-label', `Punto para doblar la conexión entre ${start.title} y ${end.title}. Arrastra o usa las flechas.`);
		handle.dataset.connectionId = connection.id;
		handle.dataset.segmentIndex = String(segmentIndex);
		handle.style.setProperty('--connection-color', CONNECTION_COLORS.has(connection.color) ? connection.color : '#a9e4cd');
		const diamond = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
		const size = 3.5;
		diamond.setAttribute('points', `${point.x},${point.y - size} ${point.x + size},${point.y} ${point.x},${point.y + size} ${point.x - size},${point.y}`);
		diamond.setAttribute('class', 'connection-handle-diamond');
		diamond.style.setProperty('--connection-color', CONNECTION_COLORS.has(connection.color) ? connection.color : '#a9e4cd');
		connectionsSvg.append(handle, diamond);
	});
}

connectionsSvg.addEventListener('pointerdown', event => {
	const handle = event.target.closest?.('.connection-handle');
	if (!handle || event.button !== 0) return;
	event.preventDefault();
	event.stopPropagation();
	connectionDrag = {
		connectionId: handle.dataset.connectionId,
		segmentIndex: Number(handle.dataset.segmentIndex),
		pointerId: event.pointerId
	};
	connectionsSvg.setPointerCapture(event.pointerId);
});
connectionsSvg.addEventListener('pointermove', event => {
	if (!connectionDrag || event.pointerId !== connectionDrag.pointerId) return;
	const matrix = connectionsSvg.getScreenCTM();
	const viewBox = connectionsSvg.viewBox.baseVal;
	if (!matrix || !viewBox.width || !viewBox.height) return;
	const screenPoint = connectionsSvg.createSVGPoint();
	screenPoint.x = event.clientX;
	screenPoint.y = event.clientY;
	const worldPoint = screenPoint.matrixTransform(matrix.inverse());
	const connection = connections.find(item => item.id === connectionDrag.connectionId);
	if (!connection) return;
	setConnectionBend(connection, connectionDrag.segmentIndex, {
		x: worldPoint.x / viewBox.width * WORLD_SCALE * 100 - WORLD_SCALE * 50,
		y: worldPoint.y / viewBox.height * WORLD_SCALE * 100 - WORLD_SCALE * 50
	});
	drawConnections();
});
function finishConnectionDrag(event) {
	if (!connectionDrag || event.pointerId !== connectionDrag.pointerId) return;
	connectionDrag = null;
	if (connectionsSvg.hasPointerCapture(event.pointerId)) connectionsSvg.releasePointerCapture(event.pointerId);
	persist();
}
